@model BankTransaction
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add transaction" : "Edit transaction";
    var action = isNew ? "Create" : "Edit";
}

<form asp-action="@action" method="post" class="app-form app-form-narrow"
      data-confirm-title="@(isNew ? "Add this transaction?" : "Save changes to this transaction?")"
      data-confirm="This changes the account's balance."
      data-confirm-ok="@(isNew ? "Yes, add transaction" : "Yes, save")">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-arrow-left-right"></i> Transaction</div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="BankAccountId" class="form-label required"></label>
                <select asp-for="BankAccountId" asp-items="ViewBag.BankAccounts" class="form-select">
                    <option value="">-- Select Bank Account --</option>
                </select>
                <span asp-validation-for="BankAccountId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TransactionDate" class="form-label required"></label>
                <input asp-for="TransactionDate" class="form-control" />
                <span asp-validation-for="TransactionDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Type" class="form-label required"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<TransactionType>()" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="Amount" class="form-label required"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="ReferenceNumber" class="form-label"></label>
                <input asp-for="ReferenceNumber" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <a class="btn btn-light" asp-action="Index" asp-route-bankAccountId="@(Model.BankAccountId > 0 ? Model.BankAccountId : null)" data-modal-cancel>Cancel</a>
        <button class="btn btn-success" type="submit"><i class="bi bi-check2"></i> @(isNew ? "Add transaction" : "Save changes")</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
