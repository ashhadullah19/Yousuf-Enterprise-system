@model BankTransaction
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Transaction" : "Edit Transaction";
    var action = Model.Id == 0 ? "Create" : "Edit";
}
<form asp-action="@action" method="post" class="card stat-card p-4" style="max-width:720px;">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="BankAccountId" class="form-label"></label>
        <select asp-for="BankAccountId" asp-items="ViewBag.BankAccounts" class="form-select">
            <option value="">-- Select Bank Account --</option>
        </select>
        <span asp-validation-for="BankAccountId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SalesInvoiceId" class="form-label">Against Invoice (optional)</label>
        <select asp-for="SalesInvoiceId" asp-items="ViewBag.Invoices" class="form-select">
            <option value="">-- none --</option>
        </select>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="TransactionDate" class="form-label"></label>
            <input asp-for="TransactionDate" class="form-control" />
            <span asp-validation-for="TransactionDate" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<TransactionType>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3 mt-3">
        <label asp-for="ReferenceNumber" class="form-label"></label>
        <input asp-for="ReferenceNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
    </div>

    <div class="mt-3">
        <button class="btn btn-success" type="submit">Save</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
 }