@using Yousuf_Enterprise_system.ViewModels
@model IEnumerable<StatementRow>
@{
    var account = (BankAccount)ViewBag.Account;
    ViewData["Title"] = $"Statement - {account.AccountTitle}";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">@account.BankName - @account.AccountTitle</h4>
        <small class="text-muted">A/C: @account.AccountNumber</small>
    </div>
    <div class="text-end">
        @if (!string.IsNullOrEmpty(ViewBag.From as string))
        {
            <div class="text-muted small">Opening Balance: @(((decimal)ViewBag.OpeningBalance).ToString("N0"))</div>
        }
        <div class="text-muted">Closing Balance</div>
        <h4 class="mb-0">@(((decimal)ViewBag.ClosingBalance).ToString("N0"))</h4>
    </div>
</div>

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-outline-danger"
           asp-action="StatementPdf"
           asp-route-bankAccountId="@account.Id"
           asp-route-from="@ViewBag.From"
           asp-route-to="@ViewBag.To"><i class="bi bi-file-earmark-pdf"></i> Download PDF</a>
    </div>
    <form class="list-toolbar-filters" method="get">
        <input type="hidden" name="bankAccountId" value="@account.Id" />
        <input type="date" class="form-control" name="from" value="@ViewBag.From" aria-label="From date" title="From" />
        <span class="filter-label">to</span>
        <input type="date" class="form-control" name="to" value="@ViewBag.To" aria-label="To date" title="To" />
        <button class="btn btn-outline-secondary">Filter</button>
    </form>
</div>

<table class="table table-striped bg-white">
    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Reference</th>
            <th>Remarks</th>
            <th class="text-end">Deposit</th>
            <th class="text-end">Withdrawal</th>
            <th class="text-end">Balance</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            var t = row.Transaction;
            <tr>
                <td>@t.TransactionDate.ToString("dd-MMM-yyyy")</td>
                <td>@t.Type</td>
                <td>@t.ReferenceNumber</td>
                <td>@t.Remarks</td>
                <td class="text-end">@if (t.Type == TransactionType.Deposit) { <span class="amount-credit">@t.Amount.ToString("N0")</span> }</td>
                <td class="text-end">@if (t.Type == TransactionType.Withdrawal) { <span class="amount-debit">@t.Amount.ToString("N0")</span> }</td>
                <td class="text-end">@row.RunningBalance.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>
<a class="btn btn-link" asp-action="Index">Back to transactions</a>