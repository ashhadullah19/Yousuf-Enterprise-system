@using Microsoft.AspNetCore.Mvc.Rendering
@model Yousuf_Enterprise_system.ViewModels.PagedResult<BankTransaction>
@{
    ViewData["Title"] = "Bank Transactions";
    var accounts = ViewBag.BankAccounts as List<SelectListItem> ?? new List<SelectListItem>();
    var selected = ViewBag.SelectedAccount as BankAccount;
    var balances = ViewBag.Balances as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var currentBalance = ViewBag.CurrentBalance as decimal? ?? 0m;
}

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" asp-route-bankAccountId="@selected?.Id" data-modal><i class="bi bi-plus-lg"></i> Add transaction</a>
        @if (selected is not null)
        {
            <a class="btn btn-outline-secondary" asp-action="Statement" asp-route-bankAccountId="@selected.Id"><i class="bi bi-file-text"></i> Statement</a>
        }
    </div>
    <form class="list-toolbar-filters" method="get">
        <select id="bankAccountId" name="bankAccountId" class="form-select" asp-items="accounts" aria-label="Bank account" onchange="this.form.q.value=''; this.form.submit()">
            <option value="">-- Select bank account --</option>
        </select>
        @if (selected is not null)
        {
            <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="Search reference or remarks..." aria-label="Search transactions" />
            <button class="btn btn-outline-secondary">Search</button>
        }
        else
        {
            <input type="hidden" name="q" value="" />
        }
    </form>
</div>

@if (!accounts.Any())
{
    <div class="table-card">
        <div class="p-4 text-center text-muted">
            No bank accounts yet. <a asp-controller="BankAccounts" asp-action="Create" data-modal>Add a bank account</a> first.
        </div>
    </div>
}
else if (selected is null)
{
    <div class="table-card">
        <div class="p-4 text-center text-muted">Select a bank account to view its transactions.</div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="fw-semibold">@selected.BankName - @selected.AccountTitle</div>
            <small class="text-muted">A/C: @selected.AccountNumber</small>
        </div>
        <div class="text-end">
            <div class="text-muted small">Current balance</div>
            <div class="h4 mb-0 @(currentBalance < 0 ? "amount-debit" : "")">@currentBalance.ToString("N0")</div>
        </div>
    </div>

    <div class="table-card">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Amount</th>
                <th class="text-end">Balance</th>
                <th>Reference</th>
                <th>Remarks</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr class="empty-row"><td colspan="7">@(string.IsNullOrWhiteSpace(ViewBag.Query as string) ? "No transactions for this account yet." : "No transactions match your search.")</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.TransactionDate.ToString("dd-MMM-yyyy")</td>
                    <td>@item.Type.GetDisplayName()</td>
                    <td><span class="@(item.Type == TransactionType.Deposit ? "amount-credit" : "amount-debit")">@item.Amount.ToString("N0")</span></td>
                    <td class="text-end">@balances.GetValueOrDefault(item.Id).ToString("N0")</td>
                    <td>@item.ReferenceNumber</td>
                    <td>@item.Remarks</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" data-modal>Edit</a>
                        @if (User.IsInRole(AppRoles.SuperAdmin))
                        {
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  data-confirm-title="Delete this transaction?" data-confirm="This permanently removes it and changes the account's balance." data-confirm-ok="Delete transaction" data-confirm-variant="danger">
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" model="Model" />
    </div>
}
