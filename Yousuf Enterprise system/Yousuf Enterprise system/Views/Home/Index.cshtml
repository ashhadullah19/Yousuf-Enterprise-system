@using Yousuf_Enterprise_system.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    static string? SignClass(decimal value) => value > 0 ? "amount-credit" : value < 0 ? "amount-debit" : null;

    var customerPanel = new ReminderPanelViewModel
    {
        Title = "Customer payments due",
        Subtitle = "Credit sales",
        Icon = "bi-person-lines-fill",
        Tone = "green",
        EmptyText = "No upcoming or overdue customer payments.",
        Items = Model.PaymentReminders.Select(r => new ReminderItem
        {
            Title = r.BuyerName,
            Reference = r.InvoiceNumber,
            ReferenceUrl = Url.Action("Details", "SalesInvoices", new { id = r.InvoiceId }),
            DueDate = r.DueDate,
            Amount = r.AmountDue,
            DismissUrl = Url.Action("DismissReminder", "SalesInvoices", new { id = r.InvoiceId }),
            DismissTitle = $"Dismiss the reminder for {r.InvoiceNumber}?",
            DismissMessage = "It won't appear on the dashboard again, even if the invoice is still unpaid."
        }).ToList()
    };

    var supplierPanel = new ReminderPanelViewModel
    {
        Title = "Supplier payments due",
        Subtitle = "Credit purchases",
        Icon = "bi-truck",
        Tone = "red",
        EmptyText = "No upcoming or overdue supplier payments.",
        Items = Model.PurchaseReminders.Select(r => new ReminderItem
        {
            Title = r.VendorName,
            Reference = r.GrnNumber,
            ReferenceUrl = Url.Action("Index", "OwnedPurchases", new { q = r.GrnNumber }),
            DueDate = r.DueDate,
            Amount = r.AmountDue,
            DismissUrl = Url.Action("DismissReminder", "OwnedPurchases", new { id = r.PurchaseId }),
            DismissTitle = $"Dismiss the reminder for {r.GrnNumber}?",
            DismissMessage = "It won't appear on the dashboard again, even if the purchase is still unpaid."
        }).ToList()
    };

    var chequePanel = new ReminderPanelViewModel
    {
        Title = "Cheque reminders",
        Subtitle = "Upcoming and overdue cheques",
        Icon = "bi-bank",
        Tone = "blue",
        EmptyText = "No upcoming or overdue cheques.",
        Items = Model.ChequeReminders.Select(c => new ReminderItem
        {
            Title = c.PartyName,
            Reference = c.LedgerNumber,
            DueDate = c.ChequeDate,
            Amount = c.Amount
        }).ToList()
    };

    var cards = new[]
    {
        (Label: "Owned stock value", Value: Model.OwnedStockValue, Icon: "bi-boxes", Tone: "teal", Hint: "Remaining stock at average purchase rate", ValueClass: (string?)null),
        (Label: "Receivables", Value: Model.Receivables, Icon: "bi-arrow-down-left-circle", Tone: "green", Hint: "Owed to you by parties", ValueClass: null),
        (Label: "Payables", Value: Model.Payables, Icon: "bi-arrow-up-right-circle", Tone: "red", Hint: "You owe to parties", ValueClass: null),
        (Label: "Today's cash flow", Value: Model.TodayCashFlow, Icon: "bi-activity", Tone: "blue", Hint: "Received minus paid today", ValueClass: SignClass(Model.TodayCashFlow)),
        (Label: "Commission receivable", Value: Model.CommissionReceivable, Icon: "bi-hourglass-split", Tone: "amber", Hint: "Accrued, still outstanding", ValueClass: null),
        (Label: "Commission received", Value: Model.CommissionReceived, Icon: "bi-check2-circle", Tone: "purple", Hint: "Settled so far", ValueClass: null),
        (Label: "Profit", Value: Model.TotalProfit, Icon: "bi-graph-up-arrow", Tone: "green", Hint: "Across all sales", ValueClass: SignClass(Model.TotalProfit)),
        (Label: "Expenses", Value: Model.TotalExpenses, Icon: "bi-cash-stack", Tone: "orange", Hint: "All recorded expenses", ValueClass: null)
    };
}

<div class="row g-3 mb-4">
    @foreach (var card in cards)
    {
        var format = card.Label == "Owned stock value" ? "N0" : "N2";
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card" data-tone="@card.Tone">
                <div class="kpi-icon"><i class="bi @card.Icon"></i></div>
                <div class="kpi-body">
                    <div class="kpi-label">@card.Label</div>
                    <div class="kpi-value @card.ValueClass" title="@card.Value.ToString(format)">@card.Value.ToString(format)</div>
                    <div class="kpi-hint">@card.Hint</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-6">
        <partial name="_ReminderPanel" model="customerPanel" />
    </div>
    <div class="col-xl-6">
        <partial name="_ReminderPanel" model="supplierPanel" />
    </div>
    <div class="col-12">
        <partial name="_ReminderPanel" model="chequePanel" />
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <section class="reminder-panel" data-tone="orange">
            <header class="reminder-header">
                <span class="reminder-header-icon"><i class="bi bi-exclamation-triangle"></i></span>
                <div class="reminder-header-text">
                    <h2>Low stock alerts</h2>
                    <span>Owned stock at or below its alert level</span>
                </div>
                @if (Model.LowStock.Any())
                {
                    <span class="reminder-count" title="@Model.LowStock.Count products">@Model.LowStock.Count</span>
                }
            </header>

            @if (!Model.LowStock.Any())
            {
                <div class="reminder-empty">
                    <i class="bi bi-check2-circle"></i>
                    <span>All products are above their alert level.</span>
                </div>
            }
            else
            {
                <ul class="reminder-list">
                    @foreach (var item in Model.LowStock)
                    {
                        var outOfStock = item.OnHand <= 0;
                        <li class="reminder-item @(outOfStock ? "is-overdue" : "is-soon")">
                            <div class="reminder-main">
                                <div class="reminder-title">@item.ProductName</div>
                                <div class="reminder-meta">Alert at @item.AlertQty.ToString("#,0.####")</div>
                            </div>
                            <div class="reminder-side">
                                <div class="reminder-amount">@item.OnHand.ToString("#,0.####")</div>
                                <span class="reminder-pill">@(outOfStock ? "Out of stock" : "Low stock")</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
    <div class="col-lg-7">
        <section class="reminder-panel" data-tone="green">
            <header class="reminder-header">
                <span class="reminder-header-icon"><i class="bi bi-receipt"></i></span>
                <div class="reminder-header-text">
                    <h2>Recent invoices</h2>
                    <span>Latest sales</span>
                </div>
                <a class="reminder-link" asp-controller="SalesInvoices" asp-action="Index">View all <i class="bi bi-arrow-right"></i></a>
            </header>

            @if (!Model.RecentInvoices.Any())
            {
                <div class="reminder-empty">
                    <i class="bi bi-receipt"></i>
                    <span>No invoices yet.</span>
                </div>
            }
            else
            {
                <ul class="reminder-list">
                    @foreach (var invoice in Model.RecentInvoices)
                    {
                        <li class="reminder-item is-neutral">
                            <div class="reminder-main">
                                <div class="reminder-title">@invoice.Buyer?.FullName</div>
                                <div class="reminder-meta">
                                    <a asp-controller="SalesInvoices" asp-action="Details" asp-route-id="@invoice.Id">@invoice.InvoiceNumber</a>
                                    <span class="reminder-dot" aria-hidden="true"></span>
                                    <span><i class="bi bi-calendar-event"></i> @invoice.InvoiceDate.ToString("dd MMM yyyy")</span>
                                    @if (invoice.Product is not null)
                                    {
                                        <span class="reminder-dot" aria-hidden="true"></span>
                                        <span>@invoice.Product.Name</span>
                                    }
                                </div>
                            </div>
                            <div class="reminder-side">
                                <div class="reminder-amount">@invoice.GrandTotalAmount.ToString("N2")</div>
                                <span class="reminder-pill">@invoice.PaymentType</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>
