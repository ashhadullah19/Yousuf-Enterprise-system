@model Yousuf_Enterprise_system.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    static string? SignClass(decimal value) => value > 0 ? "amount-credit" : value < 0 ? "amount-debit" : null;

    var cards = new[]
    {
        (Label: "Owned stock value", Value: Model.OwnedStockValue, Icon: "bi-boxes", Tone: "teal", Hint: "Remaining stock at average cost", ValueClass: (string?)null),
        (Label: "Receivables", Value: Model.Receivables, Icon: "bi-arrow-down-left-circle", Tone: "green", Hint: "Owed to you by parties", ValueClass: null),
        (Label: "Payables", Value: Model.Payables, Icon: "bi-arrow-up-right-circle", Tone: "red", Hint: "You owe to parties", ValueClass: null),
        (Label: "Today's cash flow", Value: Model.TodayCashFlow, Icon: "bi-activity", Tone: "blue", Hint: "Received minus paid today", ValueClass: SignClass(Model.TodayCashFlow)),
        (Label: "Commission receivable", Value: Model.CommissionReceivable, Icon: "bi-hourglass-split", Tone: "amber", Hint: "Accrued, still outstanding", ValueClass: null),
        (Label: "Commission received", Value: Model.CommissionReceived, Icon: "bi-check2-circle", Tone: "purple", Hint: "Settled so far", ValueClass: null),
        (Label: "Profit", Value: Model.TotalProfit, Icon: "bi-graph-up-arrow", Tone: "green", Hint: "Across all sales", ValueClass: SignClass(Model.TotalProfit)),
        (Label: "Expenses", Value: Model.TotalExpenses, Icon: "bi-cash-stack", Tone: "orange", Hint: "All recorded expenses", ValueClass: null)
    };
}

<div class="row g-3 mb-4">
    @foreach (var card in cards)
    {
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card" data-tone="@card.Tone">
                <div class="kpi-icon"><i class="bi @card.Icon"></i></div>
                <div class="kpi-body">
                    <div class="kpi-label">@card.Label</div>
                    <div class="kpi-value @card.ValueClass" title="@card.Value.ToString("N2")">@card.Value.ToString("N2")</div>
                    <div class="kpi-hint">@card.Hint</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card stat-card">
            <div class="card-header">Customer payments due <span class="text-muted small">· credit sales</span></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Invoice</th><th>Buyer</th><th>Due date</th><th>Amount due</th><th></th><th></th></tr></thead>
                    <tbody>
                        @if (!Model.PaymentReminders.Any())
                        {
                            <tr><td colspan="6" class="text-muted">No upcoming or overdue payments.</td></tr>
                        }
                        @foreach (var r in Model.PaymentReminders)
                        {
                            <tr class="@(r.IsOverdue ? "table-danger" : "table-warning")">
                                <td><a asp-controller="SalesInvoices" asp-action="Details" asp-route-id="@r.InvoiceId">@r.InvoiceNumber</a></td>
                                <td>@r.BuyerName</td>
                                <td>@r.DueDate.ToString("dd-MMM-yyyy")</td>
                                <td>@r.AmountDue.ToString("N2")</td>
                                <td>@r.Status</td>
                                <td>
                                    <form asp-controller="SalesInvoices" asp-action="DismissReminder" asp-route-id="@r.InvoiceId" method="post" class="m-0"
                                          data-confirm-title="Dismiss the reminder for @r.InvoiceNumber?" data-confirm="It won't appear on the dashboard again, even if the invoice is still unpaid." data-confirm-ok="Dismiss">
                                        <button class="btn btn-sm btn-outline-secondary" type="submit" title="Dismiss this reminder">Dismiss</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card stat-card">
            <div class="card-header">Supplier payments due <span class="text-muted small">· credit purchases</span></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>GRN</th><th>Vendor</th><th>Due date</th><th>Amount due</th><th></th><th></th></tr></thead>
                    <tbody>
                        @if (!Model.PurchaseReminders.Any())
                        {
                            <tr><td colspan="6" class="text-muted">No upcoming or overdue supplier payments.</td></tr>
                        }
                        @foreach (var r in Model.PurchaseReminders)
                        {
                            <tr class="@(r.IsOverdue ? "table-danger" : "table-warning")">
                                <td><a asp-controller="OwnedPurchases" asp-action="Index" asp-route-q="@r.GrnNumber">@r.GrnNumber</a></td>
                                <td>@r.VendorName</td>
                                <td>@r.DueDate.ToString("dd-MMM-yyyy")</td>
                                <td>@r.AmountDue.ToString("N2")</td>
                                <td>@r.Status</td>
                                <td>
                                    <form asp-controller="OwnedPurchases" asp-action="DismissReminder" asp-route-id="@r.PurchaseId" method="post" class="m-0"
                                          data-confirm-title="Dismiss the reminder for @r.GrnNumber?" data-confirm="It won't appear on the dashboard again, even if the purchase is still unpaid." data-confirm-ok="Dismiss">
                                        <button class="btn btn-sm btn-outline-secondary" type="submit" title="Dismiss this reminder">Dismiss</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card stat-card">
            <div class="card-header">Cheque reminders</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Ledger #</th><th>Party</th><th>Cheque date</th><th>Amount</th><th></th></tr></thead>
                    <tbody>
                        @if (!Model.ChequeReminders.Any())
                        {
                            <tr><td colspan="5" class="text-muted">No upcoming or overdue cheques.</td></tr>
                        }
                        @foreach (var c in Model.ChequeReminders)
                        {
                            <tr class="@(c.IsOverdue ? "table-danger" : "table-warning")">
                                <td>@c.LedgerNumber</td>
                                <td>@c.PartyName</td>
                                <td>@c.ChequeDate.ToString("dd-MMM-yyyy")</td>
                                <td>@c.Amount.ToString("N2")</td>
                                <td>@c.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card stat-card">
            <div class="card-header">Low stock alerts (owned)</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Product</th><th>On hand</th><th>Alert</th></tr></thead>
                    <tbody>
                    @if (!Model.LowStock.Any())
                    {
                        <tr><td colspan="3" class="text-muted">No alerts.</td></tr>
                    }
                    @foreach (var item in Model.LowStock)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.OnHand.ToString("N4")</td>
                            <td>@item.AlertQty.ToString("N4")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card stat-card">
            <div class="card-header">Recent invoices</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Invoice</th><th>Buyer</th><th>Total</th></tr></thead>
                    <tbody>
                    @foreach (var invoice in Model.RecentInvoices)
                    {
                        <tr>
                            <td><a asp-controller="SalesInvoices" asp-action="Details" asp-route-id="@invoice.Id">@invoice.InvoiceNumber</a></td>
                            <td>@invoice.Buyer?.FullName</td>
                            <td>@invoice.GrandTotalAmount.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
