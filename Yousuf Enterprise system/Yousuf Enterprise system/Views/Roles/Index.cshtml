@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Roles";
    var userCounts = ViewBag.UserCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="list-toolbar">
    <form asp-action="Create" method="post" class="list-toolbar-actions"
          data-confirm-title="Add this role?" data-confirm="You can set its module access from the Permissions button afterwards." data-confirm-ok="Yes, add role">
        <input class="form-control w-auto" name="name" placeholder="New role name..." aria-label="New role name" required />
        <button class="btn btn-success"><i class="bi bi-plus-lg"></i> Add role</button>
    </form>
</div>

<table class="table table-striped bg-white">
    <thead><tr><th>Role</th><th>Users</th><th></th></tr></thead>
    <tbody>
    @foreach (var role in Model)
    {
        <tr>
            <td>@role.Name</td>
            <td>@(userCounts.TryGetValue(role.Id, out var c) ? c : 0)</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Permissions" asp-route-roleId="@role.Id">Permissions</a>
                @if (role.Name is not (AppRoles.SuperAdmin or AppRoles.Accountant))
                {
                    <form asp-action="Delete" asp-route-roleId="@role.Id" method="post" class="d-inline"
                          data-confirm-title="Delete the @role.Name role?" data-confirm="This can't be undone." data-confirm-ok="Delete role" data-confirm-variant="danger">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
