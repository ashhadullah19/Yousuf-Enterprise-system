@using Yousuf_Enterprise_system.ViewModels
@model List<RolePermissionRow>
@{
    var role = ViewBag.Role as Microsoft.AspNetCore.Identity.IdentityRole;
    ViewData["Title"] = $"Permissions — {role?.Name}";
}

@if (TempData["Message"] is not null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<p class="text-muted">Super Admin always has full access regardless of these settings.</p>

<form asp-action="Permissions" asp-route-roleId="@role?.Id" method="post" class="card stat-card p-4" style="max-width:640px;">
    <table class="table">
        <thead><tr><th>Module</th><th class="text-center">Can view</th><th class="text-center">Can edit</th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>
                    @Model[i].Module
                    <input type="hidden" name="rows[@i].Module" value="@Model[i].Module" />
                </td>
                <td class="text-center">
                    <input type="hidden" name="rows[@i].CanView" value="false" />
                    <input type="checkbox" name="rows[@i].CanView" value="true" @(Model[i].CanView ? "checked" : "") class="form-check-input" />
                </td>
                <td class="text-center">
                    <input type="hidden" name="rows[@i].CanEdit" value="false" />
                    <input type="checkbox" name="rows[@i].CanEdit" value="true" @(Model[i].CanEdit ? "checked" : "") class="form-check-input" />
                </td>
            </tr>
        }
        </tbody>
    </table>
    <div class="mt-3">
        <button class="btn btn-success">Save permissions</button>
        <a class="btn btn-link" asp-action="Index">Back to roles</a>
    </div>
</form>
