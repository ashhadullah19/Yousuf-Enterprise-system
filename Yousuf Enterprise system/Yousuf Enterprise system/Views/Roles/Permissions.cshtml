@using Yousuf_Enterprise_system.ViewModels
@model List<RolePermissionRow>
@{
    var role = ViewBag.Role as Microsoft.AspNetCore.Identity.IdentityRole;
    ViewData["Title"] = $"Permissions — {role?.Name}";
}

<p class="text-muted">Super Admin always has full access regardless of these settings.</p>

<form asp-action="Permissions" asp-route-roleId="@role?.Id" method="post" class="app-form app-form-narrow"
      data-confirm-title="@($"Save permissions for {role?.Name}?")"
      data-confirm="Changes apply to everyone with this role."
      data-confirm-ok="Yes, save permissions">
    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-shield-lock"></i> Module access</div>
        <table class="table align-middle mb-0">
            <thead><tr><th>Module</th><th class="text-center">Can view</th><th class="text-center">Can edit</th></tr></thead>
            <tbody>
            @for (var i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>
                        @Model[i].Module
                        <input type="hidden" name="rows[@i].Module" value="@Model[i].Module" />
                    </td>
                    <td class="text-center">
                        <input type="hidden" name="rows[@i].CanView" value="false" />
                        <input type="checkbox" name="rows[@i].CanView" value="true" @(Model[i].CanView ? "checked" : "") class="form-check-input" aria-label="Can view @Model[i].Module" />
                    </td>
                    <td class="text-center">
                        <input type="hidden" name="rows[@i].CanEdit" value="false" />
                        <input type="checkbox" name="rows[@i].CanEdit" value="true" @(Model[i].CanEdit ? "checked" : "") class="form-check-input" aria-label="Can edit @Model[i].Module" />
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </section>

    <div class="form-actions">
        <a class="btn btn-light" asp-action="Index">Back to roles</a>
        <button class="btn btn-success" type="submit"><i class="bi bi-check2"></i> Save permissions</button>
    </div>
</form>
