@model Yousuf_Enterprise_system.ViewModels.PagedResult<DastiEntry>
@{
    ViewData["Title"] = "Dasti";
    var totalDeposits = ViewBag.TotalDeposits as decimal? ?? 0m;
    var totalWithdrawals = ViewBag.TotalWithdrawals as decimal? ?? 0m;
    var net = totalDeposits - totalWithdrawals;
    var selectedType = ((int?)ViewBag.Type)?.ToString();
    var typeOptions = Html.GetEnumSelectList<DastiType>()
        .Select(item => { item.Selected = item.Value == selectedType; return item; })
        .ToList();
}

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Add entry</a>
    </div>
    <form class="list-toolbar-filters" method="get">
        <select name="type" class="form-select" asp-items="typeOptions" aria-label="Type">
            <option value="">All types</option>
        </select>
        <input type="date" name="from" class="form-control" value="@ViewBag.From" aria-label="From date" title="From" />
        <span class="filter-label">to</span>
        <input type="date" name="to" class="form-control" value="@ViewBag.To" aria-label="To date" title="To" />
        <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="Search name or detail..." aria-label="Search dasti entries" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card stat-card p-3">
            <div class="text-muted">Cash deposits (filtered)</div>
            <div class="fs-4 amount-credit">@totalDeposits.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card p-3">
            <div class="text-muted">Cash withdrawals (filtered)</div>
            <div class="fs-4 amount-debit">@totalWithdrawals.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card p-3">
            <div class="text-muted">Net</div>
            <div class="fs-4 @(net < 0 ? "amount-debit" : "amount-credit")">@net.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>Date</th><th>Name</th><th>Type</th><th>Amount</th><th>Detail</th><th></th></tr></thead>
    <tbody>
    @if (!Model.Items.Any())
    {
        <tr class="empty-row"><td colspan="6">No dasti entries found.</td></tr>
    }
    @foreach (var item in Model.Items)
    {
        var amountClass = item.Type == DastiType.CashDeposit ? "amount-credit" : "amount-debit";
        <tr>
            <td>@item.Date.ToString("dd-MMM-yyyy")</td>
            <td>@item.Name</td>
            <td><span class="@amountClass">@item.Type.GetDisplayName()</span></td>
            <td><span class="@amountClass">@item.Amount.ToString("N2")</span></td>
            <td>@item.Detail</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" data-modal>Edit</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          data-confirm-title="Delete this entry for @item.Name?" data-confirm="This permanently removes the entry. This can't be undone." data-confirm-ok="Delete entry" data-confirm-variant="danger">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>
