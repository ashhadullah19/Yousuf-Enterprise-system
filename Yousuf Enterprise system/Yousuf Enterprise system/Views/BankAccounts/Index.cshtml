@model Yousuf_Enterprise_system.ViewModels.PagedResult<BankAccount>
@{
    ViewData["Title"] = "Bank Accounts";
}
<form class="row g-2 mb-3" method="get">
    <div class="col-md-4"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search bank account..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
    <div class="col-auto"><a class="btn btn-success" asp-action="Create">Add account</a></div>
</form>
<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>Bank Name</th><th>Account Title</th><th>Account Number</th><th>Remarks</th><th></th></tr></thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr class="empty-row"><td colspan="5">No bank accounts found.</td></tr>
        }
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.BankName</td>
                <td>@item.AccountTitle</td>
                <td>@item.AccountNumber</td>
                <td>@item.Remarks</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="BankTransaction" asp-action="Statement" asp-route-bankAccountId="@item.Id">Statement</a>
                    @if (User.IsInRole(AppRoles.SuperAdmin))
                    {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this bank account? This cannot be undone.');">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>