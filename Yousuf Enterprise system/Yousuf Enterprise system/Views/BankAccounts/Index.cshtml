@model Yousuf_Enterprise_system.ViewModels.PagedResult<BankAccount>
@{
    ViewData["Title"] = "Bank Accounts";
}
<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Add account</a>
    </div>
    <form class="list-toolbar-filters" method="get">
        <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="Search bank account..." aria-label="Search bank accounts" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>
</div>
<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>Bank Name</th><th>Account Title</th><th>Account Number</th><th>Remarks</th><th></th></tr></thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr class="empty-row"><td colspan="5">No bank accounts found.</td></tr>
        }
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.BankName</td>
                <td>@item.AccountTitle</td>
                <td>@item.AccountNumber</td>
                <td>@item.Remarks</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" data-modal>Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="BankTransaction" asp-action="Statement" asp-route-bankAccountId="@item.Id">Statement</a>
                    @if (User.IsInRole(AppRoles.SuperAdmin))
                    {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              data-confirm-title="Delete @item.AccountTitle?" data-confirm="This bank account will be permanently removed. This can't be undone." data-confirm-ok="Delete account" data-confirm-variant="danger">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>