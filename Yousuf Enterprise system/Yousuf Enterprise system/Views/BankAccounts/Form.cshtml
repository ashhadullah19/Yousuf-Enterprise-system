@model BankAccount
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add bank account" : "Edit bank account";
    var action = isNew ? "Create" : "Edit";
}

<form asp-action="@action" method="post" class="app-form app-form-narrow"
      data-confirm-title="@(isNew ? "Add this bank account?" : "Save changes to this account?")"
      data-confirm="Please make sure the account details are correct."
      data-confirm-ok="@(isNew ? "Yes, add account" : "Yes, save")">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-bank"></i> Account details</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="BankName" class="form-label required"></label>
                <input asp-for="BankName" class="form-control" />
                <span asp-validation-for="BankName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AccountTitle" class="form-label required"></label>
                <input asp-for="AccountTitle" class="form-control" />
                <span asp-validation-for="AccountTitle" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AccountNumber" class="form-label required"></label>
                <input asp-for="AccountNumber" class="form-control" />
                <span asp-validation-for="AccountNumber" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <a class="btn btn-light" asp-action="Index" data-modal-cancel>Cancel</a>
        <button class="btn btn-success" type="submit"><i class="bi bi-check2"></i> @(isNew ? "Add account" : "Save changes")</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
