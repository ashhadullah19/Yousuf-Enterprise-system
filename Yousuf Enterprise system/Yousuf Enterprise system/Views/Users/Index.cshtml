@model List<Yousuf_Enterprise_system.ViewModels.UserListItem>
@{
    ViewData["Title"] = "Users";
}

<form class="row g-2 mb-3" method="get">
    <div class="col-md-4"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Name or email..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
    <div class="col-auto"><a class="btn btn-success" asp-action="Create">Add user</a></div>
</form>

<table class="table table-striped bg-white">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th></th></tr></thead>
    <tbody>
    @foreach (var row in Model)
    {
        <tr>
            <td>@row.User.FullName</td>
            <td>@row.User.Email</td>
            <td>@string.Join(", ", row.Roles)</td>
            <td>@(row.User.IsActive ? "Yes" : "No")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@row.User.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
