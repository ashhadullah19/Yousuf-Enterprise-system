@model Yousuf_Enterprise_system.ViewModels.PagedResult<Yousuf_Enterprise_system.ViewModels.UserFormViewModel>
@{
    ViewData["Title"] = "Users";
}

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Add user</a>
    </div>
    <form class="list-toolbar-filters" method="get">
        <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="Name or email..." aria-label="Search users" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>
</div>

<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th></th></tr></thead>
    <tbody>
    @if (!Model.Items.Any())
    {
        <tr class="empty-row"><td colspan="5">No users found.</td></tr>
    }
    @foreach (var row in Model.Items)
    {
        <tr>
            <td>@row.FullName</td>
            <td>@row.Email</td>
            <td>@row.Role</td>
            <td>@(row.IsActive ? "Yes" : "No")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@row.Id" data-modal>Edit</a></td>
        </tr>
    }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>
