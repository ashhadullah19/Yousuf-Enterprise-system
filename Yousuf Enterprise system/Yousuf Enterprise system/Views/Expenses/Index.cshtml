@model Yousuf_Enterprise_system.ViewModels.PagedResult<Expense>
@{
    ViewData["Title"] = "Expenses";
    var total = ViewBag.Total as decimal? ?? 0m;
    var expenseTypes = ViewBag.ExpenseTypes as List<ExpenseType> ?? new List<ExpenseType>();
    var selectedType = ViewBag.ExpenseTypeId as int?;
}

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Add expense</a>
        <a class="btn btn-outline-secondary" asp-controller="Reports" asp-action="Expenses"><i class="bi bi-bar-chart"></i> Expense report</a>
    </div>
    <form class="list-toolbar-filters" method="get">
        <select name="expenseTypeId" class="form-select" aria-label="Expense type">
            <option value="">All types</option>
            @foreach (var type in expenseTypes)
            {
                <option value="@type.Id" selected="@(selectedType == type.Id)">@type.Name</option>
            }
        </select>
        <input type="date" name="from" class="form-control" value="@ViewBag.From" aria-label="From date" title="From" />
        <span class="filter-label">to</span>
        <input type="date" name="to" class="form-control" value="@ViewBag.To" aria-label="To date" title="To" />
        <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="Search expenses..." aria-label="Search expenses" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>
</div>

<div class="card stat-card p-3 mb-3" style="max-width:280px;">
    <div class="text-muted">Total (filtered)</div>
    <div class="fs-4 fw-semibold">@total.ToString("N0")</div>
</div>

<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>Expense #</th><th>Date</th><th>Type</th><th>Description</th><th>Mode</th><th>Amount</th><th></th></tr></thead>
    <tbody>
    @if (!Model.Items.Any())
    {
        <tr class="empty-row"><td colspan="7">No expenses recorded.</td></tr>
    }
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.ExpenseNumber</td>
            <td>@item.ExpenseDate.ToString("dd-MMM-yyyy")</td>
            <td>@item.ExpenseType?.Name</td>
            <td>@item.Description</td>
            <td>@item.Mode.GetDisplayName()@(item.BankAccount is not null ? $" ({item.BankAccount.AccountTitle})" : "")</td>
            <td>@item.Amount.ToString("N0")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" data-modal>Edit</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          data-confirm-title="Delete expense @item.ExpenseNumber?" data-confirm="This permanently removes the expense. This can't be undone." data-confirm-ok="Delete expense" data-confirm-variant="danger">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>
