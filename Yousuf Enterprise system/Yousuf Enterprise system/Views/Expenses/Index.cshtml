@model IEnumerable<Expense>
@{
    ViewData["Title"] = "Expenses";
    var total = ViewBag.Total as decimal? ?? 0m;
}

<form class="row g-2 mb-3" method="get">
    <div class="col-md-3"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search expenses..." /></div>
    <div class="col-md-2"><input type="date" name="from" class="form-control" value="@ViewBag.From" /></div>
    <div class="col-md-2"><input type="date" name="to" class="form-control" value="@ViewBag.To" /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
    <div class="col-auto"><a class="btn btn-success" asp-action="Create">Add expense</a></div>
</form>

<div class="card stat-card p-3 mb-3" style="max-width:280px;">
    <div class="text-muted">Total (filtered)</div>
    <div class="fs-4 fw-semibold">@total.ToString("N2")</div>
</div>

<table class="table table-striped bg-white">
    <thead><tr><th>Expense #</th><th>Date</th><th>Category</th><th>Description</th><th>Mode</th><th>Amount</th><th></th></tr></thead>
    <tbody>
    @if (!Model.Any())
    {
        <tr><td colspan="7" class="text-muted">No expenses recorded.</td></tr>
    }
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ExpenseNumber</td>
            <td>@item.ExpenseDate.ToString("dd-MMM-yyyy")</td>
            <td>@item.Category</td>
            <td>@item.Description</td>
            <td>@item.Mode.GetDisplayName()@(item.BankAccount is not null ? $" ({item.BankAccount.AccountTitle})" : "")</td>
            <td>@item.Amount.ToString("N2")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this expense?');">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
