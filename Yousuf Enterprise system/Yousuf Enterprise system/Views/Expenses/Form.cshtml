@model Expense
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add expense" : "Edit expense";
    var action = isNew ? "Create" : "Edit";
}

<form asp-action="@action" method="post" class="app-form"
      data-confirm-title="@(isNew ? "Record this expense?" : "Save changes to this expense?")"
      data-confirm="Please make sure the amount and details are correct."
      data-confirm-ok="@(isNew ? "Yes, record expense" : "Yes, save")">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-cash-stack"></i> Expense</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="ExpenseNumber" class="form-label"></label>
                <input asp-for="ExpenseNumber" class="form-control" readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="ExpenseDate" class="form-label"></label>
                <input asp-for="ExpenseDate" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label asp-for="Category" class="form-label required"></label>
                <input asp-for="Category" class="form-control" placeholder="e.g. Conveyance, Rent, Utilities" list="categorySuggestions" />
                <datalist id="categorySuggestions">
                    <option value="Conveyance"></option>
                    <option value="Labour"></option>
                    <option value="Rent"></option>
                    <option value="Utilities"></option>
                    <option value="Office Supplies"></option>
                    <option value="Miscellaneous"></option>
                </datalist>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
            </div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-wallet2"></i> Payment</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Amount" class="form-label required"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Mode" class="form-label"></label>
                <select asp-for="Mode" asp-items="Html.GetEnumSelectList<PaymentMode>()" class="form-select" id="modeSelect" data-online-value="@((int)PaymentMode.OnlineBankTransfer)"></select>
            </div>
            <div class="col-md-4" id="bankAccountRow">
                <label asp-for="BankAccountId" class="form-label"></label>
                <select asp-for="BankAccountId" asp-items="ViewBag.BankAccounts" class="form-select">
                    <option value="">-- select account --</option>
                </select>
                <small class="text-muted">Posts a matching withdrawal to that account's Bank Transactions.</small>
            </div>
            <div class="col-12">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <a class="btn btn-light" asp-action="Index" data-modal-cancel>Cancel</a>
        <button class="btn btn-success" type="submit"><i class="bi bi-check2"></i> @(isNew ? "Record expense" : "Save changes")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleBankAccount() {
            const el = document.getElementById('modeSelect');
            document.getElementById('bankAccountRow').style.display = el.value === el.dataset.onlineValue ? '' : 'none';
        }
        document.getElementById('modeSelect').addEventListener('change', toggleBankAccount);
        toggleBankAccount();
    </script>
}
