@using Yousuf_Enterprise_system.Services
@model IEnumerable<PartyLedgerLine>
@{
    ViewData["Title"] = "Party ledger";
    var parties = ViewBag.Parties as IEnumerable<Party> ?? Enumerable.Empty<Party>();
    var balance = ViewBag.Balance as PartyCommissionBalance;
    decimal runningReceivable = 0;
    decimal runningPayable = 0;
}

<div class="list-toolbar">
    @if (ViewBag.PartyId is int)
    {
        <div class="list-toolbar-actions">
            <a class="btn btn-outline-danger"
               asp-action="PartyLedgerPdf"
               asp-route-partyId="@ViewBag.PartyId"
               asp-route-from="@((ViewBag.From as DateTime?)?.ToString("yyyy-MM-dd"))"
               asp-route-to="@((ViewBag.To as DateTime?)?.ToString("yyyy-MM-dd"))"><i class="bi bi-file-earmark-pdf"></i> Download PDF</a>
        </div>
    }
    <form class="list-toolbar-filters" method="get">
        <select name="partyId" class="form-select" aria-label="Party">
            <option value="">Select party</option>
            @foreach (var party in parties)
            {
                if ((int?)ViewBag.PartyId == party.Id)
                {
                    <option value="@party.Id" selected>@party.FullName</option>
                }
                else
                {
                    <option value="@party.Id">@party.FullName</option>
                }
            }
        </select>
        <input type="date" name="from" class="form-control" value="@((ViewBag.From as DateTime?)?.ToString("yyyy-MM-dd"))" aria-label="From date" title="From" />
        <span class="filter-label">to</span>
        <input type="date" name="to" class="form-control" value="@((ViewBag.To as DateTime?)?.ToString("yyyy-MM-dd"))" aria-label="To date" title="To" />
        <button class="btn btn-outline-secondary">Load</button>
    </form>
</div>

@if (balance is not null)
{
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card stat-card p-3">
                <div class="text-muted">Receivable (they owe us)</div>
                <div class="fs-5 amount-credit">@balance.Receivable.ToString("N0")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card p-3">
                <div class="text-muted">Payable (we owe them)</div>
                <div class="fs-5 amount-debit">@balance.Payable.ToString("N0")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card p-3">
                <div class="text-muted">Commission receivable</div>
                <div class="fs-5 fw-semibold">@balance.CommissionReceivable.ToString("N0")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card p-3">
                <div class="text-muted">Commission received</div>
                <div class="fs-5 fw-semibold">@balance.CommissionReceived.ToString("N0")</div>
            </div>
        </div>
    </div>
}

<table class="table table-striped bg-white">
    <thead><tr><th>Date</th><th>Document</th><th>Description</th><th>Head</th><th>Debit</th><th>Credit</th><th>Receivable</th><th>Payable</th></tr></thead>
    <tbody>
    @foreach (var line in Model)
    {
        if (line.Side == DuesSide.Receivable) runningReceivable += line.Debit - line.Credit;
        if (line.Side == DuesSide.Payable) runningPayable += line.Credit - line.Debit;
        <tr>
            <td>@line.Date.ToString("dd-MMM-yyyy")</td>
            <td>@line.Document</td>
            <td>@line.Description</td>
            <td>@line.Head.GetDisplayName()</td>
            <td><span class="@(line.Debit != 0 ? "amount-debit" : "text-muted")">@line.Debit.ToString("N0")</span></td>
            <td><span class="@(line.Credit != 0 ? "amount-credit" : "text-muted")">@line.Credit.ToString("N0")</span></td>
            <td><span class="@(line.Side == DuesSide.Receivable ? null : "text-muted")">@runningReceivable.ToString("N0")</span></td>
            <td><span class="@(line.Side == DuesSide.Payable ? null : "text-muted")">@runningPayable.ToString("N0")</span></td>
        </tr>
    }
    </tbody>
</table>
