@using Yousuf_Enterprise_system.Services
@model Yousuf_Enterprise_system.ViewModels.PagedResult<Party>
@{
    ViewData["Title"] = "Party Master";
    var balances = ViewBag.Balances as Dictionary<int, PartyCommissionBalance> ?? new Dictionary<int, PartyCommissionBalance>();
    var importModal = new Yousuf_Enterprise_system.ViewModels.ImportModalViewModel
    {
        Title = "Import parties from Excel",
        EntityPlural = "parties",
        RequiredColumn = "FullName",
        Columns = new[] { "FullName", "Type", "FatherName", "PrimaryContact", "SecondaryContact", "BusinessAddress", "Ntn", "StrnSbr", "BankName", "AccountTitle", "AccountNumber", "Iban", "BranchCode" }
    };
}

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Add party</a>
        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#@importModal.Id"><i class="bi bi-file-earmark-arrow-up"></i> Import</button>
    </div>
    <form class="list-toolbar-filters" method="get">
        <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="Search name, CNIC, phone, NTN, bank..." aria-label="Search parties" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>
</div>

<partial name="_ImportModal" model="importModal" />

<div class="table-card">
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Phone</th>
            <th>NTN</th>
            <th>Receivable</th>
            <th>Payable</th>
            <th>Commission Receivable</th>
            <th>Commission Received</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @if (!Model.Items.Any())
    {
        <tr class="empty-row"><td colspan="9">No parties found.</td></tr>
    }
    @foreach (var item in Model.Items)
    {
        var balance = balances.TryGetValue(item.Id, out var b) ? b : new PartyCommissionBalance();
        <tr>
            <td>@item.FullName</td>
            <td>@item.Type.GetDisplayName()</td>
            <td>@item.PrimaryContact</td>
            <td>@item.Ntn</td>
            <td><span class="@(balance.Receivable != 0 ? "amount-credit" : "text-muted")">@balance.Receivable.ToString("N0")</span></td>
            <td><span class="@(balance.Payable != 0 ? "amount-debit" : "text-muted")">@balance.Payable.ToString("N0")</span></td>
            <td>@balance.CommissionReceivable.ToString("N0")</td>
            <td>@balance.CommissionReceived.ToString("N0")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" data-modal>Edit</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          data-confirm-title="Delete @item.FullName?" data-confirm="The party is hidden from lists; their past invoices and ledger history are kept." data-confirm-ok="Delete party" data-confirm-variant="danger">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>
