@model Party
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add party" : "Edit party";
    ViewData["ModalSize"] = "xl";
    var action = isNew ? "Create" : "Edit";
}

<form asp-action="@action" method="post" enctype="multipart/form-data" class="app-form"
      data-confirm-title="@(isNew ? "Add this party?" : "Save changes to this party?")"
      data-confirm="Please make sure the details are correct."
      data-confirm-ok="@(isNew ? "Yes, add party" : "Yes, save")">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-person-vcard"></i> Personal &amp; contact</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<PartyType>()" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="FullName" class="form-label required"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="FatherName" class="form-label"></label>
                <input asp-for="FatherName" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="PrimaryContact" class="form-label required"></label>
                <input asp-for="PrimaryContact" class="form-control" />
                <span asp-validation-for="PrimaryContact" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SecondaryContact" class="form-label"></label>
                <input asp-for="SecondaryContact" class="form-control" />
                <span asp-validation-for="SecondaryContact" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="BusinessAddress" class="form-label"></label>
                <textarea asp-for="BusinessAddress" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-bank"></i> Tax &amp; banking</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Ntn" class="form-label"></label>
                <input asp-for="Ntn" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="StrnSbr" class="form-label"></label>
                <input asp-for="StrnSbr" class="form-control" />
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="HasBankDetails" class="form-check-input" id="hasBankDetails" />
                    <label asp-for="HasBankDetails" class="form-check-label" for="hasBankDetails"></label>
                </div>
            </div>
            <div class="col-12">
                <div class="row g-3" id="bankFields">
                    <div class="col-md-4">
                        <label asp-for="BankName" class="form-label required"></label>
                        <input asp-for="BankName" class="form-control" />
                        <span asp-validation-for="BankName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AccountTitle" class="form-label required"></label>
                        <input asp-for="AccountTitle" class="form-control" />
                        <span asp-validation-for="AccountTitle" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AccountNumber" class="form-label required"></label>
                        <input asp-for="AccountNumber" class="form-control" />
                        <span asp-validation-for="AccountNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Iban" class="form-label"></label>
                        <input asp-for="Iban" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BranchCode" class="form-label"></label>
                        <input asp-for="BranchCode" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-paperclip"></i> Attachments</div>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label" for="cnicFront">CNIC front</label><input type="file" id="cnicFront" name="cnicFront" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label" for="cnicBack">CNIC back</label><input type="file" id="cnicBack" name="cnicBack" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label" for="cheque">Canceled cheque</label><input type="file" id="cheque" name="cheque" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label" for="taxCert">Tax certificate</label><input type="file" id="taxCert" name="taxCert" class="form-control" /></div>
        </div>
    </section>

    <div class="form-actions">
        <a class="btn btn-light" asp-action="Index" data-modal-cancel>Cancel</a>
        <button class="btn btn-success" type="submit"><i class="bi bi-check2"></i> @(isNew ? "Add party" : "Save changes")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleBankFields() {
            const on = document.getElementById('hasBankDetails').checked;
            document.getElementById('bankFields').style.display = on ? '' : 'none';
        }
        document.getElementById('hasBankDetails').addEventListener('change', toggleBankFields);
        toggleBankFields();
    </script>
}
