@model SalesInvoice
@{
    ViewData["Title"] = Model.InvoiceNumber;
    var paid = (decimal)ViewBag.AmountPaid;
    var settleStatus = paid <= 0 ? "Unpaid" : paid >= Model.GrandTotalAmount ? "Paid" : "Partial";
    var settleClass = settleStatus switch { "Paid" => "badge bg-success", "Partial" => "badge bg-warning text-dark", _ => "badge bg-secondary" };
}

<div class="card stat-card p-4" style="max-width:720px;">
    <div class="d-flex justify-content-between">
        <h2 class="h5">@Model.InvoiceNumber</h2>
        <a class="btn btn-outline-primary" asp-action="Pdf" asp-route-id="@Model.Id">Download PDF</a>
    </div>
    <p>@(Model.ApplyGst ? "GST Invoice" : "Non-GST Invoice") · @Model.InvoiceDate.ToString("dd-MMM-yyyy")</p>
    <p>Buyer: @Model.Buyer?.FullName</p>
    <p>Product: @Model.Product?.Name · Qty @Model.QuantitySold.ToString("N4") at @Model.RatePerUnit.ToString("N2")</p>
    <p>Subtotal: @Model.SubtotalAmount.ToString("N2")</p>
    @if (!string.IsNullOrWhiteSpace(Model.ExtraChargesDescription) || Model.ExtraChargesAmount > 0)
    {
        <p>@(Model.ExtraChargesDescription ?? "Extra charges"): @Model.ExtraChargesAmount.ToString("N2")</p>
    }
    <p>GST (@Model.GstPercentage.ToString("N2")%): @Model.GstAmount.ToString("N2")</p>
    <p class="fw-semibold">Grand total: @Model.GrandTotalAmount.ToString("N2") <span class="@settleClass">@settleStatus</span></p>
    <p>Paid so far: @paid.ToString("N2") / @Model.GrandTotalAmount.ToString("N2")</p>

    <hr />
    <p>Cost of goods sold: @Model.CostOfGoodsSold.ToString("N2")</p>
    <p>Agent commission (@Model.AgentCommissionPercentage.ToString("N2")%): @Model.AgentCommissionAmount.ToString("N2") @(Model.Agent is not null ? $"— {Model.Agent.FullName}" : "")</p>
    <p class="fw-semibold">Profit: @Model.ProfitAmount.ToString("N2")</p>

    <hr />
    <p>Payment type: @Model.PaymentType.GetDisplayName()</p>
    @if (Model.PaymentType == PaymentType.Online)
    {
        <p>Bank account: @Model.BankAccount?.AccountTitle (@Model.BankAccount?.BankName)</p>
    }
    @if (Model.PaymentType == PaymentType.Credit)
    {
        <p class="@(Model.IsOverdue ? "text-danger fw-semibold" : "")">
            Due date: @Model.DueDate?.ToString("dd-MMM-yyyy") @(Model.IsOverdue ? "(OVERDUE)" : "")
        </p>
    }

    @if (Model.StockType == StockType.ConsignmentStock)
    {
        <hr />
        <p>Owner: @Model.ConsignmentReceipt?.StockOwner?.FullName</p>
    }
    <a asp-action="Index">Back to invoices</a>
</div>