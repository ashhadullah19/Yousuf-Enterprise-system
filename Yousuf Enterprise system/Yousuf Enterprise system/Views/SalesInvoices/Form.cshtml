@model SalesInvoice
@{
    ViewData["Title"] = "Create invoice";
}

<form asp-action="Create" method="post" class="card stat-card p-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="InvoiceNumber" class="form-label"></label>
            <input asp-for="InvoiceNumber" class="form-control" readonly />
        </div>
        <div class="col-md-4">
            <label asp-for="InvoiceDate" class="form-label"></label>
            <input asp-for="InvoiceDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="BuyerId" class="form-label required"></label>
            <select asp-for="BuyerId" asp-items="ViewBag.Buyers" class="form-select">
                <option value="">-- select buyer --</option>
            </select>
            <span asp-validation-for="BuyerId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="StockType" class="form-label"></label>
            <select asp-for="StockType" asp-items="Html.GetEnumSelectList<StockType>()" class="form-select" id="stockType"></select>
        </div>
        <div class="col-md-4" id="receiptRow">
            <label asp-for="ConsignmentReceiptId" class="form-label"></label>
            <select asp-for="ConsignmentReceiptId" asp-items="ViewBag.Receipts" class="form-select" id="receiptSelect">
                <option value="">-- select receipt --</option>
            </select>
        </div>
        <div class="col-md-4" id="productRow">
            <label asp-for="ProductId" class="form-label required"></label>
            <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select" id="productSelect">
                <option value="">-- select product --</option>
            </select>
            <span asp-validation-for="ProductId" class="text-danger"></span>
            <div id="stockBadge" class="small text-muted mt-1"></div>
        </div>
        <div class="col-md-3">
            <label asp-for="QuantitySold" class="form-label required"></label>
            <input asp-for="QuantitySold" class="form-control" id="quantitySold" />
            <span asp-validation-for="QuantitySold" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="RatePerUnit" class="form-label required"></label>
            <input asp-for="RatePerUnit" class="form-control" />
            <span asp-validation-for="RatePerUnit" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="AgentId" class="form-label"></label>
            <select asp-for="AgentId" asp-items="ViewBag.Agents" class="form-select">
                <option value="">-- none --</option>
            </select>
            <small class="text-muted">Who earns this commission — tracked on their own ledger.</small>
        </div>
        <div class="col-md-3">
            <label asp-for="AgentCommissionPercentage" class="form-label"></label>
            <input asp-for="AgentCommissionPercentage" class="form-control" />
            <small class="text-muted">Commission amount is calculated automatically on save.</small>
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">&nbsp;</label>
            <div class="form-check">
                <input asp-for="ApplyGst" class="form-check-input" />
                <label asp-for="ApplyGst" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-3">
            <label asp-for="GstPercentage" class="form-label"></label>
            <input asp-for="GstPercentage" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="ExtraChargesDescription" class="form-label"></label>
            <input asp-for="ExtraChargesDescription" class="form-control" placeholder="e.g. Conveyance, Labour" />
        </div>
        <div class="col-md-3">
            <label asp-for="ExtraChargesAmount" class="form-label"></label>
            <input asp-for="ExtraChargesAmount" class="form-control" />
        </div>
    </div>

    <hr class="my-4" />
    <h6 class="text-muted mb-3">Payment</h6>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="PaymentType" class="form-label"></label>
            <select asp-for="PaymentType" asp-items="Html.GetEnumSelectList<PaymentType>()" class="form-select" id="paymentType" data-online-value="@((int)PaymentType.Online)" data-credit-value="@((int)PaymentType.Credit)"></select>
        </div>
        <div class="col-md-4" id="bankRow">
            <label asp-for="BankAccountId" class="form-label required"></label>
            <select asp-for="BankAccountId" asp-items="ViewBag.BankAccounts" class="form-select">
                <option value="">-- select account --</option>
            </select>
        </div>
        <div class="col-md-4" id="dueDateRow">
            <label asp-for="DueDate" class="form-label required"></label>
            <input asp-for="DueDate" type="date" class="form-control" />
        </div>
    </div>

    <div class="mt-4">
        <button class="btn btn-success">Issue invoice</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleReceipt() {
            const type = document.getElementById('stockType').value;
            const isConsignment = type === 'ConsignmentStock';
            document.getElementById('receiptRow').style.display = isConsignment ? '' : 'none';
            // For consignment sales the product is determined by the selected receipt,
            // so the (owned-stock-only) product dropdown isn't relevant there.
            document.getElementById('productRow').style.display = isConsignment ? 'none' : '';
            refreshStockBadge();
        }
        function togglePaymentFields() {
            const el = document.getElementById('paymentType');
            const type = el.value;
            document.getElementById('bankRow').style.display = type === el.dataset.onlineValue ? '' : 'none';
            document.getElementById('dueDateRow').style.display = type === el.dataset.creditValue ? '' : 'none';
        }
        async function refreshStockBadge() {
            const stockType = document.getElementById('stockType').value;
            const badge = document.getElementById('stockBadge');
            const qtyInput = document.getElementById('quantitySold');
            let url;
            if (stockType === 'ConsignmentStock') {
                const receiptId = document.getElementById('receiptSelect').value;
                if (!receiptId) { badge.textContent = ''; qtyInput.removeAttribute('max'); return; }
                url = `/SalesInvoices/StockInfo?stockType=ConsignmentStock&consignmentReceiptId=${receiptId}&productId=0`;
            } else {
                const productId = document.getElementById('productSelect').value;
                if (!productId) { badge.textContent = ''; qtyInput.removeAttribute('max'); return; }
                url = `/SalesInvoices/StockInfo?stockType=OwnedStock&productId=${productId}`;
            }
            try {
                const res = await fetch(url);
                const data = await res.json();
                qtyInput.setAttribute('max', data.onHand);
                let text = `Available: ${Number(data.onHand).toFixed(4)} ${data.uom}`;
                if (data.vendors && data.vendors.length) {
                    text += ' (supplied by: ' + data.vendors.map(v => `${v.name} ${Number(v.qty).toFixed(2)}`).join(', ') + ')';
                }
                badge.textContent = text;
            } catch {
                badge.textContent = '';
            }
        }
        document.getElementById('stockType').addEventListener('change', toggleReceipt);
        document.getElementById('paymentType').addEventListener('change', togglePaymentFields);
        document.getElementById('productSelect').addEventListener('change', refreshStockBadge);
        document.getElementById('receiptSelect').addEventListener('change', refreshStockBadge);
        toggleReceipt();
        togglePaymentFields();
    </script>
}