@model Yousuf_Enterprise_system.ViewModels.PagedResult<SalesInvoice>
@{
    ViewData["Title"] = "Sales & GST";
    var amountPaid = ViewBag.AmountPaid as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
}

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Create invoice</a>
    </div>
    <form class="list-toolbar-filters" method="get">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="overdueOnly" name="overdueOnly" value="true"
            @(ViewBag.OverdueOnly == true ? "checked" : "") onchange="this.form.submit()" />
            <label class="form-check-label" for="overdueOnly">Overdue only</label>
        </div>
        <select name="gst" class="form-select" onchange="this.form.submit()" aria-label="Tax">
            <option value="">All tax</option>
            <option value="true" selected="@(ViewBag.Gst is true)">GST</option>
            <option value="false" selected="@(ViewBag.Gst is false)">Non-GST</option>
        </select>
        <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="Invoice, buyer, product..." aria-label="Search invoices" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>
</div>

<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>Invoice</th><th>Date</th><th>Buyer</th><th>Payment</th><th>Due</th><th>GST</th><th>Profit</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr class="empty-row"><td colspan="10">No invoices found.</td></tr>
        }
        @foreach (var item in Model.Items)
        {
            var paid = amountPaid.TryGetValue(item.Id, out var p) ? p : 0m;
            var status = paid <= 0 ? "Unpaid" : paid >= item.GrandTotalAmount ? "Paid" : "Partial";
            var statusClass = status switch { "Paid" => "badge bg-success", "Partial" => "badge bg-warning text-dark", _ => "badge bg-secondary" };
            <tr class="@(item.IsOverdue ? "table-danger" : "")">
                <td>@item.InvoiceNumber</td>
                <td>@item.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                <td>@item.Buyer?.FullName</td>
                <td>@item.PaymentType.GetDisplayName()</td>
                <td>@(item.DueDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                <td>@(item.ApplyGst ? "Yes" : "No")</td>
                <td>@item.ProfitAmount.ToString("N0")</td>
                <td>@item.GrandTotalAmount.ToString("N0")</td>
                <td><span class="@statusClass">@status</span></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">View</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Pdf" asp-route-id="@item.Id">PDF</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>