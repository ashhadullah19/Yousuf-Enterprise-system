@model LedgerEntry
@{
    ViewData["Title"] = "Add ledger entry";
}

<form asp-action="Create" method="post" class="card stat-card p-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="LedgerNumber" class="form-label"></label>
            <input asp-for="LedgerNumber" class="form-control" readonly />
        </div>
        <div class="col-md-4">
            <label asp-for="LedgerDate" class="form-label"></label>
            <input asp-for="LedgerDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="PartyId" class="form-label required"></label>
            <select asp-for="PartyId" asp-items="ViewBag.Parties" class="form-select" id="partySelect">
                <option value="">-- select party --</option>
            </select>
            <span asp-validation-for="PartyId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<LedgerEntryType>()" class="form-select" id="entryType"></select>
        </div>
        <div class="col-md-4" id="invoiceRow">
            <label asp-for="SalesInvoiceId" class="form-label"></label>
            <select asp-for="SalesInvoiceId" class="form-select" id="invoiceSelect">
                <option value="">-- none --</option>
            </select>
            <span asp-validation-for="SalesInvoiceId" class="text-danger"></span>
            <small class="text-muted">Only shown for "Payment Received" — settles the selected invoice's outstanding due.</small>
        </div>
        <div class="col-md-4">
            <label asp-for="Head" class="form-label"></label>
            <select asp-for="Head" asp-items="Html.GetEnumSelectList<HeadType>()" class="form-select" id="headSelect"></select>
            <small class="text-muted" id="contraHeadNote" style="display:none;">Contra adjustment always applies to Direct Product.</small>
        </div>
        <div class="col-md-4">
            <label asp-for="Mode" class="form-label"></label>
            <select asp-for="Mode" asp-items="Html.GetEnumSelectList<PaymentMode>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="Amount" class="form-label required"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ReferenceNumber" class="form-label"></label>
            <input asp-for="ReferenceNumber" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="BankName" class="form-label"></label>
            <input asp-for="BankName" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Remarks" class="form-label"></label>
            <textarea asp-for="Remarks" class="form-control"></textarea>
        </div>
    </div>
    <p class="small text-muted mt-3">Contra adjustment posts only after Super Admin approval (unless you are Super Admin).</p>
    <button class="btn btn-success">Save</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const selectedInvoiceId = "@Model.SalesInvoiceId";

        function toggleInvoiceRow() {
            const typeValue = document.getElementById('entryType').value;
            const isReceived = typeValue === '@((int)LedgerEntryType.PaymentReceived)';
            const isContra = typeValue === '@((int)LedgerEntryType.ContraAdjustment)';

            document.getElementById('invoiceRow').style.display = isReceived ? '' : 'none';
            if (!isReceived) {
                document.getElementById('invoiceSelect').value = '';
            } else {
                loadOutstandingInvoices();
            }

            // Contra netting only ever applies to Direct Product (dues) — lock the Head field.
            const headSelect = document.getElementById('headSelect');
            headSelect.disabled = isContra;
            document.getElementById('contraHeadNote').style.display = isContra ? '' : 'none';
            if (isContra) {
                headSelect.value = '@((int)HeadType.DirectProductHead)';
            }
        }

        async function loadOutstandingInvoices() {
            const partyId = document.getElementById('partySelect').value;
            const select = document.getElementById('invoiceSelect');
            select.innerHTML = '<option value="">-- none --</option>';
            if (!partyId) return;
            try {
                const res = await fetch(`/LedgerEntries/OutstandingInvoices?partyId=${partyId}`);
                const invoices = await res.json();
                for (const inv of invoices) {
                    const opt = document.createElement('option');
                    opt.value = inv.id;
                    opt.textContent = inv.label;
                    if (String(inv.id) === selectedInvoiceId) opt.selected = true;
                    select.appendChild(opt);
                }
            } catch { /* ignore */ }
        }

        document.getElementById('entryType').addEventListener('change', toggleInvoiceRow);
        document.getElementById('partySelect').addEventListener('change', loadOutstandingInvoices);
        toggleInvoiceRow();
    </script>
}
