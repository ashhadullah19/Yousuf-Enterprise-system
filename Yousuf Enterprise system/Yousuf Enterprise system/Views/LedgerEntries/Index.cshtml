@model Yousuf_Enterprise_system.ViewModels.PagedResult<LedgerEntry>
@{
    ViewData["Title"] = "Financial ledgers";
}

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Add ledger entry</a>
    </div>
    <form class="list-toolbar-filters" method="get">
        <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="Ledger entry, party, reference..." aria-label="Search ledger entries" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>
</div>

<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>Ledger #</th><th>Date</th><th>Party</th><th>Type</th><th>Head</th><th>Mode</th><th>Against</th><th>Amount</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @if (!Model.Items.Any())
    {
        <tr class="empty-row"><td colspan="10">No ledger entries found.</td></tr>
    }
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.LedgerNumber</td>
            <td>@item.LedgerDate.ToString("dd-MMM-yyyy")</td>
            <td>@item.Party?.FullName</td>
            <td>@item.Type.GetDisplayName()</td>
            <td>@item.Head.GetDisplayName()</td>
            <td>@item.Mode.GetDisplayName()</td>
            <td>@(item.SalesInvoice?.InvoiceNumber ?? item.OwnedPurchase?.GrnNumber ?? "-")</td>
            <td><span class="@(item.Type == LedgerEntryType.PaymentReceived ? "amount-credit" : item.Type == LedgerEntryType.PaymentPaid ? "amount-debit" : null)">@item.Amount.ToString("N2")</span></td>
            <td>
                @if (item.Type == LedgerEntryType.ContraAdjustment && !item.ApprovedByAdmin)
                {
                    <span class="badge bg-warning text-dark">Pending approval</span>
                    @if (User.IsInRole(AppRoles.SuperAdmin))
                    {
                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline"
                              data-confirm-title="Approve @item.LedgerNumber?" data-confirm="The contra entry will be posted to the party's ledger." data-confirm-ok="Approve">
                            <button class="btn btn-sm btn-success">Approve</button>
                        </form>
                    }
                }
                else
                {
                    <span class="badge bg-success">Posted</span>
                }
            </td>
            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Pdf" asp-route-id="@item.Id">PDF</a></td>
        </tr>
    }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>
