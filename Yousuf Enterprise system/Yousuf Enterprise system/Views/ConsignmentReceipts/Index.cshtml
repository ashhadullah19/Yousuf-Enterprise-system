@model IEnumerable<ConsignmentReceipt>
@{
    ViewData["Title"] = "Consignment stock";
}

<form class="row g-2 mb-3" method="get">
    <div class="col-md-4"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Owner, product, ID..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
    <div class="col-auto"><a class="btn btn-success" asp-action="Create">Add receipt</a></div>
</form>

<table class="table table-striped bg-white">
    <thead><tr><th>ID</th><th>Date</th><th>Owner</th><th>Product</th><th>Qty</th><th>Commission %</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.ReceiptDate.ToString("dd-MMM-yyyy")</td>
            <td>@item.StockOwner?.FullName</td>
            <td>@item.Product?.Name</td>
            <td>@item.ReceivedQuantity.ToString("N4")</td>
            <td>@item.AgreedCommissionPercentage.ToString("N2")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Soft delete this receipt?');">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
