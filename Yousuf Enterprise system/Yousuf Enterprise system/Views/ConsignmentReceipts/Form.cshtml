@model ConsignmentReceipt
@{
    ViewData["Title"] = Model.Id == 0 ? "Add consignment receipt" : "Edit consignment receipt";
    var action = Model.Id == 0 ? "Create" : "Edit";
}

<form asp-action="@action" method="post" class="card stat-card p-4">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="ReceiptDate" class="form-label"></label>
            <input asp-for="ReceiptDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="StockOwnerId" class="form-label"></label>
            <select asp-for="StockOwnerId" asp-items="ViewBag.Owners" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="ProductId" class="form-label"></label>
            <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="ReceivedQuantity" class="form-label"></label>
            <input asp-for="ReceivedQuantity" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Unit" class="form-label"></label>
            <select asp-for="Unit" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="AgreedCommissionPercentage" class="form-label"></label>
            <input asp-for="AgreedCommissionPercentage" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Remarks" class="form-label"></label>
            <textarea asp-for="Remarks" class="form-control"></textarea>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-success">Save</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>
