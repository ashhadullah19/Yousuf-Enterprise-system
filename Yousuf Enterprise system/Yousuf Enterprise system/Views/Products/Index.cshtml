@model IEnumerable<Product>
@{
    ViewData["Title"] = "Product Master";
}

<form class="row g-2 mb-3" method="get">
    <div class="col-md-4"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search product..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
    <div class="col-auto"><a class="btn btn-success" asp-action="Create">Add product</a></div>
</form>

<table class="table table-striped bg-white">
    <thead><tr><th>Name</th><th>UOM</th><th>Min alert</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Uom</td>
            <td>@item.MinimumStockAlertQty.ToString("N4")</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Soft delete this product?');">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
