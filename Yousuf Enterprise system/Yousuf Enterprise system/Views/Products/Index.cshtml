@model Yousuf_Enterprise_system.ViewModels.PagedResult<Product>
@{
    ViewData["Title"] = "Product Master";
    var onHand = ViewBag.OnHand as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var importModal = new Yousuf_Enterprise_system.ViewModels.ImportModalViewModel
    {
        Title = "Import products from Excel",
        EntityPlural = "products",
        RequiredColumn = "Name",
        Columns = new[] { "Name", "Description", "Uom", "MinimumStockAlertQty", "IsActive" }
    };
}

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Add product</a>
        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#@importModal.Id"><i class="bi bi-file-earmark-arrow-up"></i> Import</button>
    </div>
    <form class="list-toolbar-filters" method="get">
        <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="Search product..." aria-label="Search products" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>
</div>

<partial name="_ImportModal" model="importModal" />

<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>Name</th><th>UOM</th><th>On hand</th><th>Min alert</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @if (!Model.Items.Any())
    {
        <tr class="empty-row"><td colspan="6">No products found.</td></tr>
    }
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Uom</td>
            <td>@(onHand.TryGetValue(item.Id, out var qty) ? qty.ToString("N4") : "-")</td>
            <td>@item.MinimumStockAlertQty.ToString("N4")</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" data-modal>Edit</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          data-confirm-title="Delete @item.Name?" data-confirm="The product is hidden from lists; past purchases and invoices are kept." data-confirm-ok="Delete product" data-confirm-variant="danger">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>
