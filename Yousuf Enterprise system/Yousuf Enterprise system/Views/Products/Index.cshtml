@model Yousuf_Enterprise_system.ViewModels.PagedResult<Product>
@{
    ViewData["Title"] = "Product Master";
    var onHand = ViewBag.OnHand as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
}

@if (TempData["Message"] is not null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form class="row g-2 mb-3" method="get">
    <div class="col-md-4"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search product..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
    <div class="col-auto"><a class="btn btn-success" asp-action="Create">Add product</a></div>
    <div class="col-auto"><a class="btn btn-outline-secondary" asp-action="DownloadTemplate">Download template</a></div>
</form>

<form asp-action="Import" method="post" enctype="multipart/form-data" class="row g-2 mb-3">
    <div class="col-md-4"><input type="file" name="file" class="form-control" accept=".xlsx" required /></div>
    <div class="col-auto"><button class="btn btn-outline-success">Import from Excel</button></div>
</form>

<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>Name</th><th>UOM</th><th>On hand</th><th>Min alert</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @if (!Model.Items.Any())
    {
        <tr class="empty-row"><td colspan="6">No products found.</td></tr>
    }
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Uom</td>
            <td>@(onHand.TryGetValue(item.Id, out var qty) ? qty.ToString("N4") : "-")</td>
            <td>@item.MinimumStockAlertQty.ToString("N4")</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Soft delete this product?');">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>
