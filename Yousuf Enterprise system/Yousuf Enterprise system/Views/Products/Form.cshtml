@model Product
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add product" : "Edit product";
    var action = isNew ? "Create" : "Edit";
}

<form asp-action="@action" method="post" class="app-form app-form-narrow"
      data-confirm-title="@(isNew ? "Add this product?" : "Save changes to this product?")"
      data-confirm="Please make sure the details are correct."
      data-confirm-ok="@(isNew ? "Yes, add product" : "Yes, save")">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-box-seam"></i> Product details</div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label required"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Uom" class="form-label"></label>
                <select asp-for="Uom" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select"></select>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-bell"></i> Stock alert &amp; status</div>
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label asp-for="MinimumStockAlertQty" class="form-label"></label>
                <input asp-for="MinimumStockAlertQty" class="form-control" />
                <div class="form-text">The dashboard warns when owned stock falls to this quantity.</div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <a class="btn btn-light" asp-action="Index" data-modal-cancel>Cancel</a>
        <button class="btn btn-success" type="submit"><i class="bi bi-check2"></i> @(isNew ? "Add product" : "Save changes")</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
