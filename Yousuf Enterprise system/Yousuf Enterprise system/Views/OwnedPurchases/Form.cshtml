@model OwnedPurchase
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add owned purchase" : "Edit owned purchase";
    ViewData["ModalSize"] = "xl";
    var action = isNew ? "Create" : "Edit";
    var bagWeightKg = ViewBag.BagWeightKg as decimal? ?? 50m;
    // Bag used to be a selectable Unit; it's now a separate informational count instead, so
    // it's dropped from new selections here but kept selectable if an existing record already
    // has it (editing shouldn't silently change historical data).
    var unitOptions = Enum.GetValues<UnitOfMeasure>()
        .Where(u => u != UnitOfMeasure.Bag || Model.Unit == UnitOfMeasure.Bag)
        .Select(u => new SelectListItem { Value = ((int)u).ToString(), Text = u.ToString(), Selected = u == Model.Unit });
}

<form asp-action="@action" method="post" class="app-form"
      data-confirm-title="@(isNew ? "Record this purchase?" : "Save changes to this purchase?")"
      data-confirm="This updates owned stock and the vendor's payable."
      data-confirm-ok="@(isNew ? "Yes, record purchase" : "Yes, save")">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-truck"></i> Purchase</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="GrnNumber" class="form-label"></label>
                <input asp-for="GrnNumber" class="form-control" readonly />
            </div>
            <div class="col-md-3">
                <label asp-for="PurchaseDate" class="form-label"></label>
                <input asp-for="PurchaseDate" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="PurchaseDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="VendorId" class="form-label required"></label>
                <select asp-for="VendorId" asp-items="ViewBag.Vendors" class="form-select">
                    <option value="">-- select vendor --</option>
                </select>
                <span asp-validation-for="VendorId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ProductId" class="form-label required"></label>
                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
                    <option value="">-- select product --</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-calculator"></i> Quantity &amp; pricing</div>
        <div class="row g-3">
            <div class="col-md-2">
                <label asp-for="Quantity" class="form-label required"></label>
                <input asp-for="Quantity" class="form-control" id="quantity" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Unit" class="form-label"></label>
                <select asp-for="Unit" asp-items="unitOptions" class="form-select" id="unit"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="RatePerUnit" class="form-label required"></label>
                <input asp-for="RatePerUnit" class="form-control" id="ratePerUnit" />
                <span asp-validation-for="RatePerUnit" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="FreightLabourCharges" class="form-label"></label>
                <input asp-for="FreightLabourCharges" class="form-control" id="freight" />
            </div>
            <div class="col-md-2">
                <label asp-for="TotalPackageWeight" class="form-label"></label>
                <input asp-for="TotalPackageWeight" class="form-control" id="packageWeight" />
                <span asp-validation-for="TotalPackageWeight" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="PackingType" class="form-label"></label>
                <select asp-for="PackingType" asp-items="Html.GetEnumSelectList<PackingType>()" class="form-select" id="packingType">
                    <option value="">-- none --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="PackingCount" class="form-label"></label>
                <input asp-for="PackingCount" class="form-control" id="packingCount" />
                <span asp-validation-for="PackingCount" class="text-danger"></span>
                <div id="bagHint" class="small text-muted mt-1"></div>
            </div>
            <div class="col-12">
                <div class="form-summary">
                    <div class="d-flex justify-content-between"><span class="text-muted">Total product cost</span><strong id="totalProductCost">0.00</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Grand total (incl. freight/labour)</span><strong id="grandTotal">0.00</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Gross weight (net + package)</span><strong id="grossWeight">0.0000</strong></div>
                </div>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-section-title"><i class="bi bi-wallet2"></i> Payment</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="PaymentType" class="form-label"></label>
                <select asp-for="PaymentType" asp-items="Html.GetEnumSelectList<PaymentType>()" class="form-select" id="paymentType" data-credit-value="@((int)PaymentType.Credit)"></select>
            </div>
            <div class="col-md-4" id="dueDateRow">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" type="date" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <a class="btn btn-light" asp-action="Index" data-modal-cancel>Cancel</a>
        <button class="btn btn-success" type="submit"><i class="bi bi-check2"></i> @(isNew ? "Record purchase" : "Save changes")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const bagWeightKg = @bagWeightKg.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const bagsPackingValue = '@((int)PackingType.Bags)';

        function updateTotals() {
            const qty = parseFloat(document.getElementById('quantity').value) || 0;
            const rate = parseFloat(document.getElementById('ratePerUnit').value) || 0;
            const freight = parseFloat(document.getElementById('freight').value) || 0;
            const packageWeight = parseFloat(document.getElementById('packageWeight').value) || 0;
            const productCost = qty * rate;
            document.getElementById('totalProductCost').textContent = productCost.toFixed(2);
            document.getElementById('grandTotal').textContent = (productCost + freight).toFixed(2);
            document.getElementById('grossWeight').textContent = (qty + packageWeight).toFixed(4);
        }

        function updateBagHint() {
            const packingType = document.getElementById('packingType').value;
            const count = parseFloat(document.getElementById('packingCount').value) || 0;
            const bagHint = document.getElementById('bagHint');
            bagHint.textContent = (packingType === bagsPackingValue && count > 0)
                ? `≈ ${(count * bagWeightKg).toFixed(2)} KG (@bagWeightKg.ToString("N0") KG/bag)`
                : '';
        }

        function toggleDueDate() {
            const el = document.getElementById('paymentType');
            document.getElementById('dueDateRow').style.display = el.value === el.dataset.creditValue ? '' : 'none';
        }

        ['quantity', 'ratePerUnit', 'freight', 'packageWeight'].forEach(id => document.getElementById(id).addEventListener('input', updateTotals));
        document.getElementById('packingType').addEventListener('change', updateBagHint);
        document.getElementById('packingCount').addEventListener('input', updateBagHint);
        document.getElementById('paymentType').addEventListener('change', toggleDueDate);
        updateTotals();
        updateBagHint();
        toggleDueDate();
    </script>
}
