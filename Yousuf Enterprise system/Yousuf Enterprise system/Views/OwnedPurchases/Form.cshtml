@model OwnedPurchase
@{
    ViewData["Title"] = Model.Id == 0 ? "Add owned purchase" : "Edit owned purchase";
    var action = Model.Id == 0 ? "Create" : "Edit";
    var bagWeightKg = ViewBag.BagWeightKg as decimal? ?? 50m;
}

<form asp-action="@action" method="post" class="card stat-card p-4">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="GrnNumber" class="form-label"></label>
            <input asp-for="GrnNumber" class="form-control" readonly />
        </div>
        <div class="col-md-4">
            <label asp-for="PurchaseDate" class="form-label"></label>
            <input asp-for="PurchaseDate" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="PurchaseDate" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="VendorId" class="form-label required"></label>
            <select asp-for="VendorId" asp-items="ViewBag.Vendors" class="form-select">
                <option value="">-- select vendor --</option>
            </select>
            <span asp-validation-for="VendorId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ProductId" class="form-label required"></label>
            <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
                <option value="">-- select product --</option>
            </select>
            <span asp-validation-for="ProductId" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Quantity" class="form-label required"></label>
            <input asp-for="Quantity" class="form-control" id="quantity" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
            <div id="bagHint" class="small text-muted mt-1"></div>
        </div>
        <div class="col-md-2">
            <label asp-for="Unit" class="form-label"></label>
            <select asp-for="Unit" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select" id="unit" data-bag-value="@((int)UnitOfMeasure.Bag)"></select>
        </div>
        <div class="col-md-2">
            <label asp-for="RatePerUnit" class="form-label required"></label>
            <input asp-for="RatePerUnit" class="form-control" id="ratePerUnit" />
            <span asp-validation-for="RatePerUnit" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="FreightLabourCharges" class="form-label"></label>
            <input asp-for="FreightLabourCharges" class="form-control" id="freight" />
        </div>
        <div class="col-md-4">
            <label asp-for="PaymentType" class="form-label"></label>
            <select asp-for="PaymentType" asp-items="Html.GetEnumSelectList<PaymentType>()" class="form-select" id="paymentType" data-credit-value="@((int)PaymentType.Credit)"></select>
        </div>
        <div class="col-md-4" id="dueDateRow">
            <label asp-for="DueDate" class="form-label"></label>
            <input asp-for="DueDate" type="date" class="form-control" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Remarks" class="form-label"></label>
            <textarea asp-for="Remarks" class="form-control"></textarea>
        </div>
        <div class="col-12">
            <div class="card bg-light p-3 border-0">
                <div class="d-flex justify-content-between"><span class="text-muted">Total product cost</span><strong id="totalProductCost">0.00</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Grand total (incl. freight/labour)</span><strong id="grandTotal">0.00</strong></div>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-success">Save</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const bagWeightKg = @bagWeightKg.ToString(System.Globalization.CultureInfo.InvariantCulture);

        function updateTotals() {
            const qty = parseFloat(document.getElementById('quantity').value) || 0;
            const rate = parseFloat(document.getElementById('ratePerUnit').value) || 0;
            const freight = parseFloat(document.getElementById('freight').value) || 0;
            const productCost = qty * rate;
            document.getElementById('totalProductCost').textContent = productCost.toFixed(2);
            document.getElementById('grandTotal').textContent = (productCost + freight).toFixed(2);

            const unitSelect = document.getElementById('unit');
            const bagHint = document.getElementById('bagHint');
            if (unitSelect.value === unitSelect.dataset.bagValue && qty > 0) {
                bagHint.textContent = `= ${(qty * bagWeightKg).toFixed(2)} KG (@bagWeightKg.ToString("N0") KG/bag)`;
            } else {
                bagHint.textContent = '';
            }
        }

        function toggleDueDate() {
            const el = document.getElementById('paymentType');
            document.getElementById('dueDateRow').style.display = el.value === el.dataset.creditValue ? '' : 'none';
        }

        ['quantity', 'ratePerUnit', 'freight'].forEach(id => document.getElementById(id).addEventListener('input', updateTotals));
        document.getElementById('unit').addEventListener('change', updateTotals);
        document.getElementById('paymentType').addEventListener('change', toggleDueDate);
        updateTotals();
        toggleDueDate();
    </script>
}
