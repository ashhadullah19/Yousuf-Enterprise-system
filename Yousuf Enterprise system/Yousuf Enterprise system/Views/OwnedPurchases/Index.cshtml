@model IEnumerable<OwnedPurchase>
@{
    ViewData["Title"] = "Owned stock purchases";
}

<form class="row g-2 mb-3" method="get">
    <div class="col-md-4"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="GRN, vendor, product..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
    <div class="col-auto"><a class="btn btn-success" asp-action="Create">Add purchase</a></div>
</form>

<table class="table table-striped bg-white">
    <thead><tr><th>GRN</th><th>Date</th><th>Vendor</th><th>Product</th><th>Qty</th><th>Total</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.GrnNumber</td>
            <td>@item.PurchaseDate.ToString("dd-MMM-yyyy")</td>
            <td>@item.Vendor?.FullName</td>
            <td>@item.Product?.Name</td>
            <td>@item.Quantity.ToString("N4") @item.Unit</td>
            <td>@item.GrandTotalAmount.ToString("N2")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
