@model Yousuf_Enterprise_system.ViewModels.PagedResult<OwnedPurchase>
@{
    ViewData["Title"] = "Owned stock purchases";
}

<div class="list-toolbar">
    <div class="list-toolbar-actions">
        <a class="btn btn-success" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Add purchase</a>
    </div>
    <form class="list-toolbar-filters" method="get">
        <input class="form-control filter-search" name="q" value="@ViewBag.Query" placeholder="GRN, vendor, product..." aria-label="Search purchases" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>
</div>

<div class="table-card">
<table class="table table-striped">
    <thead><tr><th>GRN</th><th>Date</th><th>Vendor</th><th>Product</th><th>Qty</th><th>Bags</th><th>Total</th><th></th></tr></thead>
    <tbody>
    @if (!Model.Items.Any())
    {
        <tr class="empty-row"><td colspan="8">No purchases found.</td></tr>
    }
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.GrnNumber</td>
            <td>@item.PurchaseDate.ToString("dd-MMM-yyyy")</td>
            <td>@item.Vendor?.FullName</td>
            <td>@item.Product?.Name</td>
            <td>@item.Quantity.ToString("N4") @item.Unit</td>
            <td>@(item.Bags?.ToString("N0") ?? "-")</td>
            <td>@item.GrandTotalAmount.ToString("N2")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" data-modal>Edit</a></td>
        </tr>
    }
    </tbody>
</table>
<partial name="_Pagination" model="Model" />
</div>
