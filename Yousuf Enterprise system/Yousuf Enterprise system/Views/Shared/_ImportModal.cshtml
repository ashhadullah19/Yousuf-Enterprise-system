@model Yousuf_Enterprise_system.ViewModels.ImportModalViewModel

<div class="modal fade" id="@Model.Id" tabindex="-1" aria-labelledby="@(Model.Id)Title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content import-modal" asp-action="Import" method="post" enctype="multipart/form-data"
              data-confirm-title="Import this file?"
              data-confirm="New @Model.EntityPlural are added; names that already exist are skipped."
              data-confirm-ok="Yes, import">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="@(Model.Id)Title"><i class="bi bi-file-earmark-arrow-up me-1"></i> @Model.Title</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ol class="import-steps">
                    <li>
                        <span class="import-step-title">Download the template</span>
                        <p class="small text-muted mb-2">
                            One row per record. Only <strong>@Model.RequiredColumn</strong> is required, and @Model.EntityPlural whose name already exists are skipped.
                        </p>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="DownloadTemplate"><i class="bi bi-download"></i> Download template (.xlsx)</a>
                        <details class="mt-2">
                            <summary class="small text-muted">Template columns</summary>
                            <div class="import-columns">
                                @foreach (var column in Model.Columns)
                                {
                                    <code>@column</code>
                                }
                            </div>
                        </details>
                    </li>
                    <li>
                        <label for="@(Model.Id)File" class="import-step-title">Upload the completed file</label>
                        <input type="file" id="@(Model.Id)File" name="file" class="form-control" accept=".xlsx" required />
                    </li>
                </ol>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-upload"></i> Import</button>
            </div>
        </form>
    </div>
</div>
