@using Yousuf_Enterprise_system.Models
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yousuf Enterprise</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="app-sidebar">
            <div class="brand">Yousuf Enterprise</div>
            <nav class="nav flex-column">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Parties" asp-action="Index">Parties</a>
                <a class="nav-link" asp-controller="Products" asp-action="Index">Products</a>
                <a class="nav-link" asp-controller="OwnedPurchases" asp-action="Index">Owned Stock</a>
                <a class="nav-link" asp-controller="SalesInvoices" asp-action="Index">Sales & GST</a>
                <a class="nav-link" asp-controller="Vouchers" asp-action="Index">Ledgers</a>
                <a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a>
                <a class="nav-link" asp-controller="BankAccounts" asp-action="Index">Bank Accounts</a>
                @if (User.IsInRole(AppRoles.SuperAdmin))
                {
                    <a class="nav-link" asp-controller="Users" asp-action="Index">Users</a>
                    <a class="nav-link" asp-controller="Settings" asp-action="Index">Settings</a>
                    <a class="nav-link" asp-controller="Backups" asp-action="Index">Backups</a>
                    <a class="nav-link" asp-controller="BankTransaction" asp-action="Index">Transaction</a>
                }
            </nav>
        </aside>
        <div class="app-main">
            <header class="app-topbar">
                <div>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted small">@User.Identity?.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Logout</button>
                    </form>
                </div>
            </header>
            <main class="app-content">
                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-success">@message</div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="auth-shell">
            @RenderBody()
        </main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
