@* Shared popup used for every Add/Edit form (filled in by site.js). Static backdrop so an
   accidental click outside doesn't throw away what's been typed. *@
<div class="modal fade" id="appModal" tabindex="-1" aria-labelledby="appModalTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content app-modal">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="appModalTitle"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="appModalBody"></div>
        </div>
    </div>
</div>

@* Confirmation prompt for actions on normal pages (delete, approve, settings, etc.). *@
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered confirm-dialog">
        <div class="modal-content confirm-modal">
            <div class="modal-body text-center px-4 pt-4 pb-2">
                <div class="confirm-icon confirm-icon-primary"><i class="bi bi-question-circle"></i></div>
                <h2 class="fs-5 fw-bold mt-3 mb-2" id="confirmModalTitle"></h2>
                <p class="text-muted mb-0" id="confirmModalMessage"></p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-2 pb-4">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success px-4" id="confirmModalOk">Yes</button>
            </div>
        </div>
    </div>
</div>
